# Copy to .env and fill in values
# cp .env.example .env

# Database
POSTGRES_PASSWORD=change-me-to-a-strong-password

# JWT signing key (generate with: openssl rand -base64 48)
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# Optional AI service configuration
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com

# Legacy Java-side variables are still accepted by ai-service for compatibility
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Legacy Claude variable is still accepted for compatibility
CLAUDE_API_KEY=
